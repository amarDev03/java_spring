<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<bean name="add1" class="java_spring.com.entity.Address">
		<property name="city" value="Meerut" />
		<property name="state" value="UP" />
	</bean>

	<bean name="emp1" class="java_spring.com.entity.Employee">
		<property name="id" value="2" />
		<property name="name" value="Amar Goswami" />
		<property name="gender" value="Male" />
		<property name="salary" value="300000" />
		<property name="address">

			<bean class="java_spring.com.entity.Address">
				<property name="city" value="Noida" />
				<property name="state" value="UP" />
			</bean>

		</property>
	</bean>

</beans>